{
  "expo": {
    "name": "기름값 계산기",
    "slug": "fuel-cost-calculator",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fuel-cost-calculator",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
